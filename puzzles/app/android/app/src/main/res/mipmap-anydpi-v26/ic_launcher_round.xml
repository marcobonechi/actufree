<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for API 26+. The launcher masks the foreground to whatever
     shape it prefers, so the mark is drawn inside the safe zone rather than
     filling the canvas. Pre-26 devices fall back to the square PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
